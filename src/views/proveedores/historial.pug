extends ../layout

block contenido
  //- BOTÓN VOLVER: Redirección forzada y limpia al panel general de Proveedores Homologados
  .btn-volver-container(style="margin-bottom: 15px;")
    a.btn-action-base.btn-ficha(href="/proveedores" style="background: #3b7be2; font-size: 13px; font-weight: 700; color: white; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600;")
      i.fa-solid.fa-arrow-left
      |  Volver al panel de Proveedores

  p(style="color: var(--text-muted); font-size: 14px; margin-bottom: 24px;")
    i.fa-solid.fa-folder-open
    |  Dossier Logístico y Auditoría de Suministros. Historial cronológico de órdenes de compra emitidas, partidas de reabastecimiento y trazabilidad de insumos.

  //- TARJETA MAESTRA DE INFORMACIÓN DEL PROVEEDOR
  .panel-alta.summary-grid
    div
      span.summary-label Razón Social / Entidad
      h3.summary-value-main #{proveedor.nombre}
    div
      span.summary-label CUIT Identificador
      p.summary-value-mono #{proveedor.cuit}
    div
      span.summary-label Contacto / Teléfono
      p.summary-value-numeric(style="font-family: var(--font-mono); color: #475569;") #{proveedor.contacto || 'No especificado'}
    div
      span.summary-label Condición de Estado
      p
        span(class=proveedor.activo !== false ? 'status-activo' : 'status-bloqueado' style="font-size: 11px; padding: 4px 8px; border-radius: 4px;") #{proveedor.activo !== false ? 'Homologado' : 'Inactivo'}

  //- LISTADO HISTÓRICO DE ÓRDENES DE COMPRA
  h2.section-title-icon(style="font-size: 15px; font-weight: 700; color: #334155; margin-top: 28px; margin-bottom: 12px; display: inline-flex; align-items: center; gap: 8px;")
    i.fa-solid.fa-clock-rotate-left(style="color: #64748b;")
    | Registro Cronológico de Órdenes de Suministro Emitidas

  .table-container
    table.data-table
      thead
        tr
          th(style="width: 160px;") Fecha Solicitud
          th Código Orden
          th Detalle de Artículos y Cantidades Solicitadas
          th Estado de Recepción
      tbody
        if !ordenes || ordenes.length === 0
          tr
            td(colspan="4" style="text-align: center; padding: 32px; color: var(--text-muted); font-weight: 500;") Este proveedor homologado aún no registra órdenes de compra emitidas en el sistema logístico.
        else
          each ord in ordenes
            tr
              td(style="font-weight: 500; color: #475569;")
                i.fa-regular.fa-calendar(style="margin-right: 6px; color: #94a3b8;")
                | #{new Date(ord.createdAt).toLocaleString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
              td
                span.id-badge ##{ord._id.toString().slice(-6).toUpperCase()}
              td
                if ord.items && ord.items.length > 0
                  ul(style="margin: 0; padding-left: 14px; list-style-type: none;")
                    each item in ord.items
                      li.item-list-desc(style="padding: 2px 0; font-size: 13px; color: #1e293b;")
                        if item.productoId
                          | • 
                          strong #{item.productoId.nombre} 
                          | x #{item.cantidad} u.
                        else
                          | • 
                          span(style="color: var(--text-muted); font-style: italic;") [Artículo removido del catálogo maestro]
                else
                  span(style="color: var(--text-muted); font-style: italic;") Sin ítems especificados
              td
                span.badge-status(class=`status-${ord.estado || 'completada'}`) #{ord.estado || 'Completada'}