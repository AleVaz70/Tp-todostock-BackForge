doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title TodoStock S.A. - Registro de Operadores
    style.
      .auth-container { max-width: 450px; margin: 50px auto; padding: 30px; background: #fff; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); font-family: sans-serif; }
      .auth-title { text-align: center; color: #008080; margin-bottom: 20px; font-size: 24px; }
      .form-group { margin-bottom: 15px; }
      .form-group label { display: block; margin-bottom: 5px; color: #333; font-weight: bold; }
      .form-control { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
      .btn-auth { width: 100%; padding: 12px; background: #008080; color: #fff; border: none; border-radius: 4px; font-size: 16px; cursor: pointer; font-weight: bold; }
      .btn-auth:hover { background: #006666; }
      .alert { padding: 10px; margin-bottom: 15px; border-radius: 4px; display: none; font-size: 14px; text-align: center; }
      .alert-danger { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
      .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
      .auth-footer { text-align: center; margin-top: 15px; font-size: 14px; }
      .auth-footer a { color: #ff6600; text-decoration: none; font-weight: bold; }
  body(style="background-color: #f4f6f9;")
    .auth-container
      h2.auth-title Alta de Operador
      p(style="text-align: center; color: #666; margin-top: -15px; margin-bottom: 25px;") Configuración de Seguridad BackForge
      #alert-box.alert
      form#register-form
        .form-group
          label(for="nombre") Nombre Completo
          input#nombre.form-control(type="text", name="nombre", placeholder="Ej: Alejandra Vazquez", required)
        .form-group
          label(for="email") Correo Electrónico
          input#email.form-control(type="email", name="email", placeholder="nombre@todostock.com", required)
        .form-group
          label(for="password") Contraseña (Mínimo 8 caracteres)
          input#password.form-control(type="password", name="password", placeholder="********", minlength="8", required)
        .form-group
          label(for="rol") Rol Asignado (Modelo RBAC)
          select#rol.form-control(name="rol", required)
            option(value="Vendedor") Vendedor (Comercialización y Crédito)
            option(value="Compras") Compras (Logística y Control FEFO)
            option(value="Administrador") Administrador (Acceso Total)
        button.btn-auth(type="submit") Registrar Usuario
      .auth-footer
        p ¿Ya tenés un usuario registrado? 
          a(href="/login") Iniciar Sesión
    script.
      document.getElementById('register-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const nombre = document.getElementById('nombre').value;
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        const rol = document.getElementById('rol').value;
        const alertBox = document.getElementById('alert-box');
        try {
          const res = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nombre, email, password, rol })
          });
          const data = await res.json();
          alertBox.className = 'alert';
          if (!res.ok) {
            alertBox.textContent = data.mensaje || 'Error en el registro';
            alertBox.classList.add('alert-danger');
            alertBox.style.display = 'block';
          } else {
            alertBox.textContent = '¡Usuario creado con éxito! Redirigiendo...';
            alertBox.classList.add('alert-success');
            alertBox.style.display = 'block';
            setTimeout(() => {
              window.location.href = '/login';
            }, 2000);
          }
        } catch (err) {
          alertBox.textContent = 'Error de conexión con el servidor';
          alertBox.classList.add('alert-danger');
          alertBox.style.display = 'block';
        }
      });